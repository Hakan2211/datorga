{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theralo",
  "identifier": "de.datorga.thera",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui",
      "wait": false
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Theralo – Dokumentation",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "whisper/*": "whisper/",
      "llama/*": "llama/",
      "diarize/*": "diarize/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QzZFOUJCQjFCMTIzRjYKUldUMkk3R3h1K25HMTduM2tnL0VjYnZJRS8yYnhPMnNQS0tOTVFZbytNZm5RTmMydnE1K2dCcFYK",
      "endpoints": [
        "https://github.com/Hakan2211/theralo-landing/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
